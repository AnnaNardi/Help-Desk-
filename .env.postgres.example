# Adicione estas variáveis ao .env local ou configure-as no serviço Node.
# Use senha longa e única. Não publique o arquivo .env.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=helpdesk
PGUSER=helpdesk_app
PGPASSWORD=troque-por-uma-senha-forte-do-banco
PGSSL=false
JWT_SECRET=troque-por-um-segredo-aleatorio-com-mais-de-32-caracteres
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_NAME=Administrador do Sistema
INITIAL_ADMIN_PASSWORD=defina-uma-senha-forte-com-12-ou-mais-caracteres
HOST=127.0.0.1
PORT=3001
# Para uso por domínio diferente do da API, configure o domínio exato:
# ALLOWED_ORIGIN=https://helpdesk.example.com
