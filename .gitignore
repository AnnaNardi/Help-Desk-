work/
backups/

# Local database files and exports. PostgreSQL server data normally lives
# outside this repository; never commit dumps or local database copies.
*.db
*.sqlite
*.sqlite3
*.dump
*.backup
*.sql.gz
postgres-data/
pgdata/
database-data/

# pods-manager atomic build operations (rename/restore leftovers).
# AppManager creates these during build (set-aside previous output before
# running pnpm build, restore on failure). Success path cleans them up;
# failure paths may leave orphans. Always ignore them in version control +
# in the sandbox memGit hydration (see ProjectSandbox.hydrate).
*.bak-*
*.legacy-bak-*
*.failed-*
*.tmp

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Evaluation screenshots
screenshot.png
.eslintcache
.oxlintcache

# Environment variables
.env*
!.env.postgres.example
src/assets/image-6f358.png

# Linux kernel core dumps (e.g. when oxfmt or pnpm crash)
core.[0-9]*
